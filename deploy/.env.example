# Copy to /srv/backend/diff-review-service/.env on the server (root:root, chmod 600).
# Never commit the real file - it is outside the git checkout on purpose.

# Bearer token clients must send: Authorization: Bearer <AUTH_TOKEN>
AUTH_TOKEN=change-me

# REQUIRED in production. The contract asks for the llm provider to be fully
# configured on this server, and the Postman suite's step 27 fails while it is
# not: an empty key leaves llm jobs degrading gracefully to "failed", which is
# correct behaviour for an outage but not a configured provider.
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
# Any OpenAI-compatible endpoint works here (gateway, self-hosted runtime).
LLM_BASE_URL=https://api.openai.com
LLM_TIMEOUT_MS=20000
# Output ceiling for one model reply. A 64 KiB chunk can produce a long findings
# array; too low a value truncates the JSON mid-element and fails the job.
LLM_MAX_TOKENS=16000
